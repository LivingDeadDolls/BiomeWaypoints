{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}+${minecraft_version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/LivingDeadDolls/BiomeWaypoints",
        "issues": "https://github.com/LivingDeadDolls/BiomeWaypoints/issues"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "biomewaypoints.BiomeWaypointsFabricClient"
        ],
        "modmenu": [
            "biomewaypoints.ModMenuIntegration"
        ],
        "waypointsapi": [
            "biomewaypoints.waypoints.BiomeWaypointsPlugin"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "yet_another_config_lib_v3": "*",
        "seedengine": "*",
        "waypointsapi": "*",
        "minecraft": "${fabric_minecraft_dependency}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "modmenu": "*"
    },
    "custom": {
        "modmenu": {
            "parent": "waypointsapi"
        }
    }
}
